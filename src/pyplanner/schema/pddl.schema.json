{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Leontes/PyPlanner/schema/pddl.schema.json",
  "title": "PyPlanner PDDL-JSON",
  "description": "Representación JSON de un dominio, un problema o un plan PDDL. Dominios y problemas son la entrada del planificador (fase 2 del parser); los planes, su salida. Versión 1: STRIPS. Versión 2: PDDL 1.2 (subconjunto ADL: tipos, precondiciones negativas, disyunciones, cuantificadores, igualdad y efectos condicionales). Versión 3: PDDL 2.1 numérico (funciones, expresiones, comparaciones, efectos numéricos, valores iniciales y métrica) y costes de acción.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "domain",
        "problem",
        "plan"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "domain"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/domain"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "problem"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/problem"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plan"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plan"
      }
    }
  ],
  "$defs": {
    "version": {
      "description": "Versión del formato (1 a 3). Las versiones nuevas solo añaden construcciones, así que un documento de una versión anterior sigue siendo válido.",
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "loc": {
      "description": "Posición opcional en el fichero PDDL original (el fichero va en 'source' a nivel de documento).",
      "type": "object",
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "name": {
      "description": "Nombre PDDL: empieza por letra y sigue con letras, dígitos, '-' o '_'.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "variable": {
      "description": "Variable PDDL: un nombre precedido de '?'.",
      "type": "string",
      "pattern": "^\\?[A-Za-z][A-Za-z0-9_-]*$"
    },
    "term": {
      "description": "Argumento de un átomo: una variable si empieza por '?' y un objeto o constante en otro caso.",
      "anyOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "$ref": "#/$defs/variable"
        }
      ]
    },
    "requirement": {
      "type": "string",
      "pattern": "^:[a-z][a-z-]*$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/variable"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        },
        "type": {
          "$ref": "#/$defs/type_spec"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "object": {
      "description": "Declaración de un objeto (problema) o una constante (dominio), con tipo opcional.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        },
        "type": {
          "$ref": "#/$defs/type_spec"
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "predicate": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "atom": {
      "description": "Átomo: (predicado arg1 arg2 ...).",
      "type": "object",
      "required": [
        "op",
        "predicate",
        "args"
      ],
      "properties": {
        "op": {
          "const": "atom"
        },
        "predicate": {
          "$ref": "#/$defs/name"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "formula": {
      "description": "Fórmula lógica (precondiciones, objetivos y condiciones de 'when'). v1: átomos y conjunciones; v2: or, not, imply, exists, forall e =; v3: comparaciones numéricas (compare).",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "atom",
            "and",
            "or",
            "not",
            "imply",
            "exists",
            "forall",
            "=",
            "compare"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "atom"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/atom"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "and"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "const": "and"
              },
              "args": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/formula"
                }
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "or"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "const": "or"
              },
              "args": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/formula"
                }
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "not"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "arg"
            ],
            "properties": {
              "op": {
                "const": "not"
              },
              "arg": {
                "$ref": "#/$defs/formula"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "imply"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "const": "imply"
              },
              "args": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/formula"
                }
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "exists"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "parameters",
              "arg"
            ],
            "properties": {
              "op": {
                "const": "exists"
              },
              "parameters": {
                "$ref": "#/$defs/quantified"
              },
              "arg": {
                "$ref": "#/$defs/formula"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "forall"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "parameters",
              "arg"
            ],
            "properties": {
              "op": {
                "const": "forall"
              },
              "parameters": {
                "$ref": "#/$defs/quantified"
              },
              "arg": {
                "$ref": "#/$defs/formula"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "="
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "const": "="
              },
              "args": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/term"
                }
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "compare"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "comparator",
              "left",
              "right"
            ],
            "properties": {
              "op": {
                "const": "compare"
              },
              "comparator": {
                "enum": [
                  "<",
                  "<=",
                  "=",
                  ">=",
                  ">"
                ]
              },
              "left": {
                "$ref": "#/$defs/expression"
              },
              "right": {
                "$ref": "#/$defs/expression"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "effect": {
      "description": "Efecto de una acción. v1: átomos añadidos, átomos borrados ('not') y conjunciones; v2: forall y when; v3: efectos numéricos.",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "atom",
            "not",
            "and",
            "forall",
            "when",
            "increase",
            "decrease",
            "assign",
            "scale-up",
            "scale-down"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "atom"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/atom"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "not"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "arg"
            ],
            "properties": {
              "op": {
                "const": "not"
              },
              "arg": {
                "$ref": "#/$defs/atom"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "and"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "const": "and"
              },
              "args": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/effect"
                }
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "forall"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "parameters",
              "arg"
            ],
            "properties": {
              "op": {
                "const": "forall"
              },
              "parameters": {
                "$ref": "#/$defs/quantified"
              },
              "arg": {
                "$ref": "#/$defs/effect"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "when"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "condition",
              "arg"
            ],
            "properties": {
              "op": {
                "const": "when"
              },
              "condition": {
                "$ref": "#/$defs/formula"
              },
              "arg": {
                "$ref": "#/$defs/literal_effect"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "increase"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "decrease"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "assign"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "scale-up"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "scale-down"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "precondition": {
          "$ref": "#/$defs/formula"
        },
        "effect": {
          "$ref": "#/$defs/effect"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "required": [
        "version",
        "kind",
        "name"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "kind": {
          "const": "domain"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "type": "string",
          "description": "Fichero PDDL del que procede el documento."
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type_decl"
          }
        },
        "constants": {
          "$ref": "#/$defs/objects"
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/function_decl"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "required": [
        "version",
        "kind",
        "name",
        "domain",
        "goal"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "kind": {
          "const": "problem"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "domain": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "type": "string",
          "description": "Fichero PDDL del que procede el documento."
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "objects": {
          "$ref": "#/$defs/objects"
        },
        "init": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/init_element"
          }
        },
        "goal": {
          "$ref": "#/$defs/formula"
        },
        "metric": {
          "$ref": "#/$defs/metric"
        }
      },
      "additionalProperties": false
    },
    "plan": {
      "description": "Plan secuencial: la salida del planificador.",
      "type": "object",
      "required": [
        "version",
        "kind",
        "domain",
        "problem",
        "cost",
        "steps"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "kind": {
          "const": "plan"
        },
        "domain": {
          "$ref": "#/$defs/name"
        },
        "problem": {
          "$ref": "#/$defs/name"
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "metric": {
          "description": "Valor de la métrica del problema, si los costes de acción la representan.",
          "type": "number"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "args"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "args": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "type_spec": {
      "description": "Tipo de un objeto o parámetro: un nombre, o una lista de nombres para (either ...).",
      "anyOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      ]
    },
    "type_decl": {
      "description": "Declaración de un tipo; sin 'parent', su supertipo es 'object'.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parent": {
          "$ref": "#/$defs/name"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "quantified": {
      "description": "Variables de un cuantificador (al menos una).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "literal_effect": {
      "description": "Efecto simple: un átomo añadido, un átomo borrado ('not'), un efecto numérico o una conjunción de ellos. Es lo único que admite 'when'.",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "atom",
            "not",
            "and",
            "increase",
            "decrease",
            "assign",
            "scale-up",
            "scale-down"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "atom"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/atom"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "not"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "arg"
            ],
            "properties": {
              "op": {
                "const": "not"
              },
              "arg": {
                "$ref": "#/$defs/atom"
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "and"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "const": "and"
              },
              "args": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/literal_effect"
                }
              },
              "loc": {
                "$ref": "#/$defs/loc"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "increase"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "decrease"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "assign"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "scale-up"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "scale-down"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/numeric_effect"
          }
        }
      ]
    },
    "fluent": {
      "description": "Término de función: (función arg1 ... argN).",
      "type": "object",
